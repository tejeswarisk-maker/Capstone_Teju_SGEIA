# ── Environment & Secrets ─────────────────────────────────────────────────────
.env

# ── Large data files (too big for GitHub / Render) ────────────────────────────
data/source_files/
data/originals/
# DS2 is 268 MB — excluded from git; generated by scripts/generate_ds2_sample.py on Render
data/household_power_consumption.csv
data/*.txt
data/*.zip

# ── Runtime-generated data (regenerated at startup, do not commit) ───────────
data/feedback_log.csv
data/live_telemetry.csv
data/lu*.tmp
*.tmp

# ── Keep these small files in git (DS1=19MB, incidents=80KB) ─────────────────
# data/smart_grid_stability_augmented.csv  ← tracked
# data/grid_incidents_synthetic.csv        ← tracked

# ── Generated outputs — keep models & chroma_db in git (small: ~8 MB total) ──
# chroma_db/   ← tracked (vector index, ~2 MB)
# models_saved/← tracked (joblib models, ~6 MB)
logs/

