# ─────────────────────────────────────────────────────────────────────────────
# SGEIA — Environment Variables
# Copy this file to .env and fill in your actual keys.
# NEVER commit .env to version control.
# ─────────────────────────────────────────────────────────────────────────────

# ── OpenAI (REQUIRED — paid API key) ─────────────────────────────────────────
OPENAI_API_KEY=sk-...your-key-here...

# ── Google AI Studio (FREE fallback — get at https://aistudio.google.com) ────
GOOGLE_API_KEY=AIza...your-key-here...

# ── Groq (FREE fallback — get at https://console.groq.com) ───────────────────
GROQ_API_KEY=gsk_...your-key-here...

# ── LangSmith (FREE developer tier — get at https://smith.langchain.com) ─────
LANGCHAIN_API_KEY=ls__...your-key-here...
LANGCHAIN_TRACING_V2=true
LANGCHAIN_PROJECT=SGEIA-Capstone

# ── Application Settings ──────────────────────────────────────────────────────
# Log level: DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO

# ChromaDB persistent directory (relative to project root)
CHROMA_DB_PATH=./chroma_db

# Saved ML models directory
MODELS_PATH=./models_saved

# Data directory
DATA_PATH=./data

# API host/port
API_HOST=127.0.0.1
API_PORT=8000

# Streamlit port
STREAMLIT_PORT=8501
